    agent any

    stages {
        stage('Start') {
            steps {
                echo 'Pipeline started'
            }
        }

        stage('Build') {
            steps {
                echo 'Build completed'
            }
        }

        stage('Test') {
            steps {
                echo 'Testing completed'
            }
        }

        stage('End') {
            steps {
                echo 'Pipeline completed successfully'
            }
        }
    }
}
